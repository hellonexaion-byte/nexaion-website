<script>
const $ = id =>
document.getElementById(id);
const NXA_SIMPLE_USER = window.NEXAION_ROLE === "user";
if(NXA_SIMPLE_USER){
 const heading=document.getElementById("nxaDetailsHeader");
 if(heading)heading.style.display="none";
 for(const el of document.querySelectorAll(".nxa-3p,#browserEvidenceStatus,#batchDiagnostics,#nxaActionRequired")){
  el.hidden=true;el.style.display="none";
 }
}


let lastResults = [];
let publisherCheckCache = new Map();
let publisherCacheHits = 0;
let publisherCacheMisses = 0;
let runInProgress = false;
// v7.4 persistent workspace: indexed rows, not one oversized sessionStorage JSON.
// It survives navigation, normal refreshes and browser restarts in the same profile.
const NXA_ACCOUNT_ID=String(window.NEXAION_ACCOUNT_ID || '');
if(!/^[0-9]+$/.test(NXA_ACCOUNT_ID))throw new Error('Authenticated account identity unavailable');
const NXA_SESSION_KEY='nexaion_workspace_account_v1_'+NXA_ACCOUNT_ID;
const NXA_DB_NAME='nexaion_workspace_account_v1_'+NXA_ACCOUNT_ID;
let nxaPersistTimer=0, nxaRestoring=false, nxaReady=false;
let nxaWrites=Promise.resolve();
let nxaDbPromise=null;
function nxaDB(){
 if(nxaDbPromise)return nxaDbPromise;
 nxaDbPromise=new Promise((resolve,reject)=>{
  const req=indexedDB.open(NXA_DB_NAME,1);
  req.onupgradeneeded=()=>{const db=req.result;if(!db.objectStoreNames.contains('rows'))db.createObjectStore('rows',{keyPath:'idx'});if(!db.objectStoreNames.contains('meta'))db.createObjectStore('meta')};
  req.onsuccess=()=>resolve(req.result);req.onerror=()=>reject(req.error);
 });return nxaDbPromise;
}
async function nxaTx(store,mode,callback){
 const db=await nxaDB();return new Promise((resolve,reject)=>{
  const tx=db.transaction(store,mode);const os=tx.objectStore(store);
  let response;try{response=callback(os)}catch(e){reject(e);return}
  tx.oncomplete=()=>resolve(response?.result);tx.onerror=()=>reject(tx.error);tx.onabort=()=>reject(tx.error);
 });
}
function nxaQueueWrite(callback){
 nxaWrites=nxaWrites.then(callback,callback).catch(err=>{
  console.error('NexAion: persistent results save failed',err);
  $('nxaBackupWarning').hidden=false;
 });return nxaWrites;
}
function nxaWriteRow(r,idx){if(nxaRestoring)return;
 nxaQueueWrite(()=>nxaTx('rows','readwrite',os=>os.put({idx,result:r})));
}
function nxaSaveWorkspace(){
 const snapshot={version:3,mode:$('crawlType').value,urls:$('urls').value,lines:$('lines').value,
  concurrency:$('concurrency').value,batchSize:nxaCurrentBatchSize,
  batch:$('batchDiagnostics').textContent,batchVisible:!$('batchDiagnostics').hidden,
  browserStatus:$('browserEvidenceStatus').textContent,browserVisible:!$('browserEvidenceStatus').hidden,
  status:$('status').textContent,bar:$('bar').style.width,savedAt:new Date().toISOString()};
 // Tiny session checkpoint; never write the full result array to sessionStorage.
 try{sessionStorage.setItem(NXA_SESSION_KEY,JSON.stringify(snapshot))}catch(e){console.warn('Session checkpoint failed',e)}
 nxaQueueWrite(()=>nxaTx('meta','readwrite',os=>os.put(snapshot,'workspace')));
}
function nxaScheduleSave(){clearTimeout(nxaPersistTimer);nxaPersistTimer=setTimeout(nxaSaveWorkspace,250)}
async function nxaReadStored(){const db=await nxaDB();return new Promise((resolve,reject)=>{
 const tx=db.transaction(['meta','rows'],'readonly');let meta=null,rows=[];
 tx.objectStore('meta').get('workspace').onsuccess=e=>{meta=e.target.result||null};
 tx.objectStore('rows').openCursor().onsuccess=e=>{const c=e.target.result;if(c){rows.push(c.value.result);c.continue()}};
 tx.oncomplete=()=>resolve({meta,rows});tx.onerror=()=>reject(tx.error);
})}
async function nxaResetStored(){await nxaWrites;nxaWrites=Promise.resolve();await nxaTx('rows','readwrite',os=>os.clear());}
async function nxaRestoreWorkspace(){
 nxaRestoring=true;$('run').disabled=true;$('nxaRecoveryStatus').hidden=false;
 $('nxaRecoveryStatus').textContent='Restoring saved crawler results\u2026';
 try{
  const disk=await nxaReadStored();let state=disk.meta;
  if(!state){try{state=JSON.parse(sessionStorage.getItem(NXA_SESSION_KEY)||'null')}catch{}}
  if(state){
   if(state.mode==='urls'||state.mode==='appids'){$('crawlType').value=state.mode; $('crawlType').dataset.nxaAppSelection=state.mode;}
   if(state.mode==='web' && typeof nxaSetBubbleMode==='function')nxaSetBubbleMode('web');
   renderCrawlMode($('crawlType').value);
   $('urls').value=state.urls||'';$('lines').value=state.lines||'';
   if(state.concurrency)$('concurrency').value=state.concurrency;
   nxaCurrentBatchSize=state.batchSize||disk.rows.length;
   if(window.NEXAION_ROLE !== 'user' && state.batchVisible){$('batchDiagnostics').hidden=false;$('batchDiagnostics').textContent=state.batch||''}
   if(window.NEXAION_ROLE !== 'user' && state.browserVisible){$('browserEvidenceStatus').hidden=false;$('browserEvidenceStatus').textContent=state.browserStatus||''}
   if(state.status)$('status').textContent=state.status;
   if(state.bar)$('bar').style.width=state.bar;
  }
  lastResults=disk.rows; nxaPage=0; nxaRenderResultPage();
  if(disk.rows.length){
   $('nxaRecoveryStatus').textContent='Recovered '+disk.rows.length+' results from local storage. Export CSV to back up your batch.';
   $('nxaRecoveryStatus').hidden=false;
   if(disk.rows.some(r=>r.browserQueue?.taskId))attachBrowserEvidence().catch(()=>{});
  }else{$('nxaRecoveryStatus').hidden=true}
 }catch(e){console.error('NexAion recovery unavailable:',e);$('nxaRecoveryStatus').textContent='Local recovery unavailable: '+e.message}
 finally{nxaRestoring=false;nxaReady=true;$('run').disabled=(typeof nxaSelectedMode!=='undefined' && nxaSelectedMode==='web');nxaUpdateRateAndFilter()}
}


/* =========================
PARSE INPUT
========================= */

function parse(t){
return (t || "")
.split("\\n")
.map(x => x.trim())
.filter(Boolean);
}

/* =========================
DEDUPE INPUTS
========================= */

function dedupeKey(input,crawlType){

const raw =
String(input || "")
.trim();

if(!raw){
return "";
}

if(crawlType === "appids"){
return "app:" + raw;
}
if(crawlType === "web") {
  try {
    const u = new URL((raw.startsWith("http://") || raw.startsWith("https://")) ? raw : "https://" + raw);
    return "web:" + u.hostname.toLowerCase() + "/ads.txt";
  } catch (_) { return "web-raw:" + raw; }
}

let value =
raw.replace(/\\s+/g,"");

const lowerValue =
value.toLowerCase();

if(
!lowerValue.startsWith("http://") &&
!lowerValue.startsWith("https://")
){
value =
"https://" + value;
}

try{

const parsed =
new URL(value);

const host =
parsed.host.toLowerCase();

let pathname =
parsed.pathname || "/";

if(pathname === "/"){
pathname =
"/app-ads.txt";
}

if(
pathname.length > 1 &&
pathname.endsWith("/")
){
pathname =
pathname.slice(0,-1);
}

return (
"url:" +
host +
pathname +
parsed.search
);

}
catch(e){

return "raw:" + raw;

}

}


function dedupeInputs(
inputs,
crawlType
){

const seen =
new Set();

const unique =
[];

const duplicates =
[];

for(
const input of inputs
){

const key =
dedupeKey(
input,
crawlType
);

if(
seen.has(key)
){

duplicates.push(
input
);

continue;

}

seen.add(key);

unique.push(
input
);

}

return {
unique,
duplicates
};

}


/* =========================
PROGRESS
========================= */

function setProgress(
done,
total
){

const pct =
total
? (done / total) * 100
: 0;

$("bar").style.width =
pct + "%";

$("status").innerText =
"Checked " +
done +
" / " +
total;

}


/* =========================
ADD RESULT ROW
========================= */

// Presence-only result classification. TLS and retrieval errors remain in details.
function nxaConclusiveInvalid(r){
 // Keep underlying browser Queue history, but a confirmed invalid seller-file
 // is a final content result, not a task requiring human intervention.
 return r.status==='INVALID_CONTENT' ||
   (r.browserQueue?.status==='REVIEW_REQUIRED' && r.browserQueue.reviewReason==='INVALID_CONTENT');
}
function nxaOverallStatus(r){
 if(nxaConclusiveInvalid(r))return 'INVALID_CONTENT';
 if(r.browserAssist?.results?.length){
  return "3P VERIFIED";
 }
 if(r.status==='TLS_RECOVERED')return 'VALID';
 return r.browserQueue?.status==='VERIFYING' ? 'VERIFYING \xB7 BROWSER AGENT' : r.browserQueue?.status==='REVIEW_REQUIRED' ? 'REVIEW_REQUIRED \xB7 '+(r.browserQueue.reviewReason||'BROWSER_ERROR') : r.browserQueue?.status==='PENDING' ? 'QUEUED \xB7 '+(r.status||'UNKNOWN') : (r.status||'UNKNOWN');
}
function nxaPresenceCounts(r){
 if(r.browserAssist?.results?.length)return {found:r.browserAssist.results.filter(x=>x.result==='FOUND').length,missing:r.browserAssist.results.filter(x=>x.result==='MISSING').length,checked:true};
 if(r.status==='VALID'||r.status==='TLS_RECOVERED'||r.status==='PARENT_DISCOVERED')return {found:Number(r.presentCount)||0,missing:Number(r.missingCount)||0,checked:true};
 return {found:0,missing:0,checked:false};
}
let nxaCurrentBatchSize=0;
function nxaRenderCards(){
 const rows=lastResults||[];
 const total=Math.max(nxaCurrentBatchSize,rows.length);
 let fetched=0,failed=0,pending=0,verifying=0,found=0,missing=0;
 for(const r of rows){
  const c=nxaPresenceCounts(r);
  if(c.checked){fetched++;found+=c.found;missing+=c.missing;continue;}
  if(r.browserQueue?.status==='PENDING'){pending++;continue;}
  if(r.browserQueue?.status==='VERIFYING'){verifying++;continue;}
  failed++;
 }
 function card(key,value){const base=key==='nxaDone'?total:(fetched+failed);const percent=base?Math.round(value/base*100):0;$(key+'Num').textContent=value+' / '+total;$(key+'Pct').textContent=percent+'%';$(key+'Bar').style.width=percent+'%';}
 card('nxaFail',failed);card('nxaFetch',fetched);card('nxaDone',fetched+failed);

 // 3P task progress: count completed and review tasks separately from direct retrieval.
 let waiting3p=0,verifying3p=0,review3p=0,finished3p=0;
 for(const r of rows){
  const q=r.browserQueue?.status||'';
  if(r.browserAssist?.results?.length || q==='BROWSER_ASSISTED') finished3p++;
  else if(q==='REVIEW_REQUIRED' && !nxaConclusiveInvalid(r))review3p++;
  else if(q==='VERIFYING')verifying3p++;
  else if(q==='PENDING')waiting3p++;
 }
 const total3p=waiting3p+verifying3p+review3p+finished3p;
 const processed3p=review3p+finished3p;
 const pct3p=total3p?Math.round(processed3p/total3p*100):0;
 $('nxa3pCaption').textContent=verifying3p?'Trying 3P service \xB7 '+verifying3p+' active':waiting3p?'Trying 3P service \xB7 '+waiting3p+' queued':total3p?'3P verification \xB7 '+processed3p+' processed':'3P service idle';
 $('nxa3pProgress').textContent=processed3p+' / '+total3p;
 $('nxa3pFill').style.width=pct3p+'%';
 $('nxa3pTrack').setAttribute('aria-valuenow',String(pct3p));
 $('nxaActionRequired').hidden=review3p===0;
 $('nxaActionCount').textContent=review3p?'('+review3p+')':'';
 $('nxaFailFoot').textContent=failed+' unresolved URLs \xB7 Missing seller lines do not count as failed URLs';
 $('nxaFetchFoot').textContent=found+' lines FOUND \xB7 '+missing+' lines MISSING';
 $('nxaDoneFoot').textContent=pending+' queued \xB7 '+verifying+' verifying \xB7 '+Math.max(0,total-rows.length)+' awaiting direct check';
}
function nxaUpdateRateAndFilter(){
 nxaRenderCards();
 let found=0,checked=0;
 for(const r of lastResults){const c=nxaPresenceCounts(r);if(c.checked){found+=c.found;checked+=c.found+c.missing;}}
 $('nxaSuccessRate').textContent='Line match rate: '+(checked?((100*found/checked).toFixed(1)+'% ('+found+'/'+checked+')'):'\u2014');
 nxaRenderResultPage();
}
function nxaPaintRow(r){
if (r.status !== "VALID" && r.status !== "TLS_RECOVERED" && r.status !== "PARENT_DISCOVERED" && Array.isArray(r.results)) {
  r.results = r.results.map(x=>({...x,present:null}));
  r.presentCount=0; r.missingCount=0;
}

const tr =
document.createElement("tr");

const td1 =
document.createElement("td");

td1.textContent =
r.input ||
r.url ||
"";

const td2 =
document.createElement("td");

td2.textContent =
(r.browserAssist?.finalUrl || r.browserAssist?.publisherUrl || (r.status==='TLS_RECOVERED' ? (r.finalUrl || r.checkedUrl) : r.checkedUrl)) ||
r.resolvedDomain ||
"N/A";

const td3 =
document.createElement("td");

td3.textContent =
nxaOverallStatus(r);

td3.title = r.status === "TLS_RECOVERED" ? "File retrieved using an unverified TLS certificate: " + (r.diagnostics?.tlsError || "UNKNOWN_CERTIFICATE_ERROR") + ". Seller lines are compared against recovered, unauthenticated content." : r.browserAssist ? "Third-party Chrome seller-line comparison; direct retrieval: " + (r.status || "UNKNOWN") : r.browserQueue?.status === "PENDING" ? "Waiting for browser-agent verification. Direct retrieval: " + (r.status||"UNKNOWN") : "";
td3.className = r.browserAssist ? "ok" : r.status === "TLS_RECOVERED" ? "queued" : r.status === "VALID" || r.status === "PARENT_DISCOVERED" ? "ok" : ["PENDING","VERIFYING","REVIEW_REQUIRED"].includes(r.browserQueue?.status) ? "queued" : "bad";
if(["PENDING","VERIFYING"].includes(r.browserQueue?.status) && !r.browserAssist){
 const live=document.createElement("div");live.className="nxa-live";
 const dot=document.createElement("span");dot.className="nxa-dot";dot.setAttribute("aria-hidden","true");
 const message=document.createElement("span");message.textContent=r.browserQueue.status==="VERIFYING"?"Browser agent is processing this task":"Waiting for browser agent \xB7 status checks while tab is active";
 live.append(dot,message);td3.append(live);
}

const td4 =
document.createElement("td");

td4.textContent = r.browserAssist ? r.browserAssist.results.filter(x=>x.result==="FOUND").length : (r.presentCount || 0);
