  const lines=r.results.map(x=>x.line).filter(x=>typeof x==='string');
  if(url && lines.length===r.results.length)entries.push({url,lines});
 }
 window.postMessage({channel:'NEXAION_ACTIVE_CRAWL_V1',type:'SNAPSHOT',runEpoch:nxaBrowserRunEpoch,entries},location.origin);
