/* =========================
CONCURRENCY POOL
========================= */

async function pool(
items,
limit,
fn,
cb
){

let i =
0;

let done =
0;

let active =
0;

return new Promise(
resolve => {

function next(){

while(
active < limit &&
i < items.length
){

const item =
items[i++];

active++;

fn(item)

.then(cb)

.catch(e => {

cb({

input:
item,

url:
item,

status:
e.apiDiagnostics?.errorSource === "WORKER_API_RESPONSE" || e.apiDiagnostics?.errorSource === "BROWSER_TO_WORKER_NETWORK" ? "API_ERROR" : "UNKNOWN",

error:
e.message,

diagnostics:
e.apiDiagnostics ||
{
errorSource:
"CLIENT_EXCEPTION"
},

presentCount:
0,

missingCount:
0,

results:
[]

});

})

.finally(() => {

active--;

done++;

setProgress(
done,
items.length
);

if(
done ===
items.length
){

resolve();

}
else{

next();

}

});

}

}

next();

}
);

}


