if(r.status){

const li =
document.createElement("li");

li.textContent =
"Status: " +
r.status +
" | HTTP: " +
(r.httpStatus ?? "N/A");

ul.appendChild(li);

}

if(r.inputType){

const li =
document.createElement("li");

li.textContent =
"Input type: " +
r.inputType;

ul.appendChild(li);

}

if(r.resolvedDomain){

const li =
document.createElement("li");

li.textContent =
"Developer domain: " +
r.resolvedDomain;

ul.appendChild(li);

}

if(r.resolverUrl){

const li =
document.createElement("li");

li.textContent =
"Resolver: " +
r.resolverUrl;

