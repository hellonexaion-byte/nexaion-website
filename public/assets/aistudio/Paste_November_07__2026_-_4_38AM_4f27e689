if(r.checkedUrl){

const li =
document.createElement("li");

li.textContent =
"Checked URL: " +
r.checkedUrl;

ul.appendChild(li);

}

if(
r.finalUrl &&
r.finalUrl !== r.checkedUrl
){

const li =
document.createElement("li");

