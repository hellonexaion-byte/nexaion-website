  // Preserve original queue task association when the listing omits an older task.
  // Invalidate stale browser evidence only when this exact task is observed with a non-completed state.
  if(r.status==="VALID"||r.status==="TLS_RECOVERED"||r.status==="PARENT_DISCOVERED")continue;
  const url=browserUrlKey(r.browserQueue?.publisherUrl||(String(r.input||"").toLowerCase().startsWith("http://")||String(r.input||"").toLowerCase().startsWith("https://")?r.input:(r.checkedUrl||r.input)));
