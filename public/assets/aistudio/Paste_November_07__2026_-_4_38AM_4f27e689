async function postJsonWithDiagnostics(
path,
payload
){

const started =
performance.now();

let res;

try{

res =
await fetch(
path,
{
method:"POST",

headers:{
"content-type":
"application/json"
},

body:
JSON.stringify(
payload
)

}
);

}
catch(e){

const err =
new Error(
e.message ||
String(e)
);

err.apiDiagnostics = {

apiHttpStatus:
null,

apiRequestMs:
Math.round(
performance.now() -
started
),

errorSource:
"BROWSER_TO_WORKER_NETWORK",

apiError:
err.message

};

throw err;

}

const apiRequestMs =
Math.round(
performance.now() -
started
);

let body =
null;

let raw =
"";

try{

raw =
await res.text();

body =
raw
? JSON.parse(raw)
: {};

}
catch(e){

const err =
new Error(
"Invalid JSON from Worker" +
(
raw
? ": " +
raw.slice(
0,
180
)
: ""
)
);

err.apiDiagnostics = {

apiHttpStatus:
res.status,

apiRequestMs:
apiRequestMs,

errorSource:
"WORKER_API_RESPONSE",

apiError:
err.message

};

throw err;

}

if(!res.ok){

const err =
new Error(
body &&
body.error
? body.error
: "HTTP " +
res.status
);

err.apiDiagnostics = {

...(
body &&
body.diagnostics
? body.diagnostics
: {}
),

apiHttpStatus:
res.status,

apiRequestMs:
apiRequestMs,

errorSource:
(
body &&
body.diagnostics &&
body.diagnostics.errorSource
) ||
"WORKER_API_HTTP"

};

throw err;

}

body =
body ||
{};

body.diagnostics = {

...(
body.diagnostics ||
{}
),

apiHttpStatus:
res.status,

apiRequestMs:
apiRequestMs

};

return body;

}


