document.createElement("summary");

summary.textContent =
"view";

const ul =
document.createElement("ul");

if(r.error){

const li =
document.createElement("li");

li.textContent =
"Error: " + r.error;

ul.appendChild(li);

}

if(r.parentDomain){
const li=document.createElement("li");
li.textContent="PARENT FILE FOUND (discovery only): "+r.checkedUrl+" | requested URL: "+(r.originalCheckedUrl||r.input)+" | original status: "+(r.originalStatus||"UNKNOWN");
ul.appendChild(li);
}

if(r.reason){

const li =
document.createElement("li");

li.textContent =
"Reason: " + r.reason;

